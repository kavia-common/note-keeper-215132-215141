# Backend environment example for Supabase
# Use one of the approaches below.

# 1) Direct Postgres via SQLAlchemy (recommended for server-side)
#DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@<HOST>:5432/postgres?sslmode=require

# 2) Using Supabase clients (PostgREST); used if you integrate supabase-py
#SUPABASE_URL=https://YOUR-PROJECT.supabase.co
#SUPABASE_ANON_KEY=ey...
#SUPABASE_SERVICE_ROLE_KEY=ey... (server-side only; never expose to frontend)
