# Copy this file to .env and adjust values as needed.

# DATABASE CONFIGURATION
# If set, the backend connects to Supabase Postgres using this URL (recommended for staging/production).
# Example (ensure sslmode=require is present for Supabase):
# DATABASE_URL=postgresql+psycopg2://postgres:<PASSWORD>@<HOST>:5432/postgres?sslmode=require

# For local development, you may omit DATABASE_URL to use a local SQLite database at sqlite:///./dev.db
# DATABASE_URL=

# Optional Supabase settings (not required for direct SQLAlchemy access)
# SUPABASE_URL=https://<your-project>.supabase.co
# SUPABASE_ANON_KEY=your-anon-key
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
